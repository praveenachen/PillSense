# Copy to .env.agent. This file is for the local Python worker only.
# Use the existing Convex deployment's HTTP Actions URL plus /agent/service.
CONVEX_AGENT_URL=https://your-existing-deployment.convex.site/agent/service

# Set the same generated value in Convex with:
# npx convex env set PILLSENSE_AGENT_SERVICE_SECRET
PILLSENSE_AGENT_SERVICE_SECRET=

# Optional. Leave blank to run the clearly labeled NON-LLM deterministic fallback.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-5-5

AGENT_POLL_SECONDS=5
