# Existing Convex deployment (copy from `npx convex dev` output/dashboard)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk application keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk JWT issuer used by convex/auth.config.ts (for example, https://...clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=

# Cartesia voice APIs (server-only; never prefix with NEXT_PUBLIC_)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Server-side Claude Vision label scanning in the Next.js API route.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# Local-only OpenCV bridge URL. This is not a secret and must remain loopback.
NEXT_PUBLIC_VISION_BRIDGE_URL=http://127.0.0.1:8101

# Development-only synthetic demo CLI. Set the same values on the existing
# Convex development deployment with `npx convex env set`; never use in prod.
PILLSENSE_DEMO_ENVIRONMENT=development
# Exact Clerk/Convex `tokenIdentifier` of the authorized demo caregiver.
PILLSENSE_DEMO_OPERATOR_TOKEN_IDENTIFIER=
