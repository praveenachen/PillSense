# Copy to .env.fetch. Never commit the real file or seed phrases.
# This reuses the existing authenticated Convex service bridge.
CONVEX_AGENT_URL=https://your-existing-deployment.convex.site/agent/service
PILLSENSE_AGENT_SERVICE_SECRET=

# Required: stable private seed phrase for the public ACP agent.
PILLSENSE_AGENT_SEED=

# Optional bonus two-uAgent flow.
EXTERNAL_CARE_AGENT_SEED=

# PillSense address is derived locally. The external values are optional.
PILLSENSE_AGENT_ADDRESS=
PILLSENSE_AGENTVERSE_ALLOWED_SENDER=

# Copy the caregiver-authorized alias shown on /agent-activity.
# This is the only case the public ASI:One chat workflow may resolve.
# Never paste it into ASI:One, Agentverse profile text, or source control.
PILLSENSE_DEMO_CASE_ALIAS=

PILLSENSE_AGENTVERSE_WAIT_SECONDS=180
PILLSENSE_AGENTVERSE_POLL_SECONDS=3
PILLSENSE_AGENTVERSE_PORT=8100
EXTERNAL_CARE_AGENT_PORT=8101
